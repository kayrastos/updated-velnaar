{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velnar-canary-ops-worker",
  "main": "worker/canaryOpsWorker.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "velnar-production-db",
      "database_id": "d65abcb3-d8d6-46fb-9403-a97ab54de303",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
