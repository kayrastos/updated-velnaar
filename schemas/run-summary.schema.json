{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kayra.local/schemas/run-summary.schema.json",
  "title": "Kayra evaluation run summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "started_at", "finished_at", "duration_ms",
    "model", "runtime", "input_sha256", "config_sha256", "result_reference",
    "distinct_case_count", "execution_count", "success_count", "failure_count",
    "skipped_count", "error_rate", "profiles", "errors",
    "semantic_scoring_performed", "pipeline_warning", "benchmark"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/id" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "number", "minimum": 0 },
    "model": { "$ref": "#/$defs/model_identity" },
    "runtime": { "$ref": "#/$defs/runtime_identity" },
    "input_sha256": { "$ref": "#/$defs/sha256" },
    "config_sha256": { "$ref": "#/$defs/sha256" },
    "result_reference": { "$ref": "#/$defs/result_reference" },
    "distinct_case_count": { "type": "integer", "minimum": 1 },
    "execution_count": { "type": "integer", "minimum": 1 },
    "success_count": { "type": "integer", "minimum": 0 },
    "failure_count": { "type": "integer", "minimum": 0 },
    "skipped_count": { "type": "integer", "minimum": 0 },
    "error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/profile_summary" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error_summary" }
    },
    "semantic_scoring_performed": { "type": "boolean" },
    "pipeline_warning": {
      "const": "Pipeline-only evaluation; results are not semantic quality scores or model benchmarks."
    },
    "benchmark": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/benchmark" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": { "name": { "const": "mock" } },
            "required": ["name"]
          }
        },
        "required": ["runtime"]
      },
      "then": {
        "properties": {
          "semantic_scoring_performed": { "const": false },
          "benchmark": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "artifact_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 200 },
        "revision": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "artifact_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "runtime_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "platform"],
      "properties": {
        "name": { "enum": ["lm_studio", "llama_cpp", "mock"] },
        "version": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
        "platform": { "type": "string", "minLength": 2, "maxLength": 100 }
      }
    },
    "result_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "record_count"],
      "properties": {
        "path": { "const": "results.jsonl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "record_count": { "type": "integer", "minimum": 1 }
      }
    },
    "profile_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile", "execution_count", "success_count", "failure_count",
        "skipped_count", "error_rate"
      ],
      "properties": {
        "profile": { "enum": ["thinking", "non_thinking"] },
        "execution_count": { "type": "integer", "minimum": 0 },
        "success_count": { "type": "integer", "minimum": 0 },
        "failure_count": { "type": "integer", "minimum": 0 },
        "skipped_count": { "type": "integer", "minimum": 0 },
        "error_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "error_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "count"],
      "properties": {
        "type": {
          "enum": [
            "configuration", "connection", "timeout", "http_status",
            "malformed_response", "model_unavailable", "capability_unavailable",
            "privacy_policy", "internal"
          ]
        },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count", "warmup_count", "ram_baseline_mib", "ram_idle_mib",
        "ram_peak_mib", "vram_baseline_mib", "vram_idle_mib", "vram_peak_mib",
        "tokens_per_second", "first_token_ms", "total_ms"
      ],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 1 },
        "warmup_count": { "type": "integer", "minimum": 0 },
        "ram_baseline_mib": { "type": ["number", "null"], "minimum": 0 },
        "ram_idle_mib": { "type": ["number", "null"], "minimum": 0 },
        "ram_peak_mib": { "type": ["number", "null"], "minimum": 0 },
        "vram_baseline_mib": { "type": ["number", "null"], "minimum": 0 },
        "vram_idle_mib": { "type": ["number", "null"], "minimum": 0 },
        "vram_peak_mib": { "type": ["number", "null"], "minimum": 0 },
        "tokens_per_second": { "type": ["number", "null"], "minimum": 0 },
        "first_token_ms": { "type": ["number", "null"], "minimum": 0 },
        "total_ms": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
