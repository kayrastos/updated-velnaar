    "serial": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "issued_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "not_before": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "not_after": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
