    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 104857600},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 104857600},
    "root_generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
