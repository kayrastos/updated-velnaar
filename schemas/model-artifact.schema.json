{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kayra.local/schemas/model-artifact.schema.json",
  "title": "Kayra model artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "repository",
    "commit",
    "license",
    "format",
    "quantization",
    "context_length",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{1,63}$"
    },
    "format": { "const": "GGUF" },
    "quantization": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_]{1,31}$"
    },
    "context_length": {
      "type": "integer",
      "minimum": 512,
      "maximum": 131072
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/artifactFile" }
    }
  },
  "$defs": {
    "artifactFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "size_bytes", "sha256"],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 6,
          "maxLength": 205,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}\\.gguf$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
