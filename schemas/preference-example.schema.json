{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kayra.local/schemas/preference-example.schema.json",
  "title": "Kayra preference example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "split", "language", "category",
    "prompt_messages", "chosen", "rejected", "preference_reason",
    "provenance", "content_sha256", "pii"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "split": { "enum": ["train", "validation"] },
    "language": { "enum": ["tr", "en", "mixed"] },
    "category": { "type": "string", "minLength": 2, "maxLength": 80 },
    "prompt_messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "items": { "$ref": "#/$defs/prompt_message" }
    },
    "chosen": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "rejected": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "preference_reason": { "type": "string", "minLength": 10, "maxLength": 4000 },
    "provenance": { "$ref": "sft-example.schema.json#/$defs/provenance" },
    "content_sha256": { "$ref": "sft-example.schema.json#/$defs/sha256" },
    "pii": { "$ref": "sft-example.schema.json#/$defs/pii" },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    }
  },
  "$defs": {
    "prompt_message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 65536 }
      }
    }
  }
}

