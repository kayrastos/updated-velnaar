[Unit]
Description=VELNAR one-shot live operator orchestration

[Service]
Type=oneshot
WorkingDirectory=%h/updated-velnaar
EnvironmentFile=%h/.config/velnar/live-orchestrator.env
ExecStart=%h/updated-velnaar/node_modules/.bin/tsx %h/updated-velnaar/scripts/fulgor/orchestration/operatorMain.ts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
KillMode=control-group
TimeoutStartSec=15min
