# AI Provider Secrets (Server-Side Cloudflare Worker bindings only)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# AI Provider Model Configurations (Explicit model selection required per provider)
VELNAR_AI_GEMINI_FAST_MODEL=
VELNAR_AI_GEMINI_REASONING_MODEL=
VELNAR_AI_DEEPSEEK_MODEL=
VELNAR_AI_KIMI_MODEL=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# VELNAR Master KMS Secret for Zero-Trust Identity Vault Envelope Encryption (AES-GCM-256 HKDF Root)
VELNAR_MASTER_KMS_SECRET=

# Runtime Environment (production | preview | development | test)
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=https://app.velnar.studio,https://velnar.studio
